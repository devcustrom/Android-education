<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidLabs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".lab1.Lab1Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".lab2.Lab2Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".lab3.AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".lab3.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".lab4.Lab4Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".lab4.CacheViewActivity"
            android:exported="false"
            android:parentActivityName=".lab4.Lab4Activity" />

        <activity
            android:name=".lab5.Lab5Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".lab5.NoteEditActivity"
            android:exported="false"
            android:parentActivityName=".lab5.Lab5Activity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".lab6.Lab6Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          Виджет «Котёнок дня». `exported="false"` — правильное значение и здесь:
          системная рассылка APPWIDGET_UPDATE адресована конкретному компоненту,
          а не «всем желающим».
        -->
        <receiver
            android:name=".lab6.widget.CatWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
          AppCompat хранит выбранный язык приложения между запусками сам, но
          только если объявлен этот сервис с `autoStoreLocales`. Без него
          `setApplicationLocales` на API < 33 «забудется» после перезапуска.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>


        <!--
          На API 24+ нельзя отдать другому приложению Uri.fromFile(...) —
          система выбросит FileUriExposedException. FileProvider выдаёт
          разрешённый Uri только для каталогов из res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>