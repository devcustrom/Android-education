<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон виджета — обычный shape-drawable, а не тема приложения: виджет живёт на
  чужом экране (лаунчер) и не наследует тему Activity.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6202124" />
    <corners android:radius="16dp" />
</shape>
